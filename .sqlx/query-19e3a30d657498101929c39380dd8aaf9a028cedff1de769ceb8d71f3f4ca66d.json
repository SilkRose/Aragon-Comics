  "query": "UPDATE Panels\n\t\t\tSET\n\t\t\t\tpanel_revision = panel_revision + 1,\n\t\t\t\tbytes_original = $3,\n\t\t\t\tbytes_compressed = $4,\n\t\t\t\tdate_modified = now()\n\t\t\tWHERE\n\t\t\t\tcomic_id = $1\n\t\t\tAND\n\t\t\t\tpanel_number = $2\n\t\t\tRETURNING\n\t\t\t\tcomic_id, panel_number, panel_revision, bytes_original,\n\t\t\t\tbytes_compressed, date_modified, date_created;",
